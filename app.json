{
  "expo": {
    "name": "ecofield",
    "slug": "ecofield",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ecofield",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O app CJnet necessita da sua localização para verificar a viabilidade técnica e cobertura de fibra óptica no seu endereço.",
        "NSCameraUsageDescription": "O app CJnet necessita de acesso à câmera para fotografar o roteador/ONU e registrar a resolução dos chamados técnicos."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O app CJnet necessita da sua localização para verificar a viabilidade técnica e cobertura de fibra óptica no seu endereço."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O app CJnet necessita de acesso à câmera para fotografar o roteador/ONU e registrar a resolução dos chamados técnicos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
